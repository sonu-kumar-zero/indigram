{
  "name": "indigram",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run buildc && npm run dev --workspace=@indigram/api",
    "buildc": "npm run build --workspace=@indigram/database && npm run build --workspace=@indigram/api",
    "typecheck": "npm run typecheck --workspace=@indigram/database && npm run typecheck --workspace=@indigram/api",
    "db:generate": "npm run db:generate --workspace=@indigram/database",
    "db:migrate": "npm run db:migrate --workspace=@indigram/database",
    "db:deploy": "npm run db:deploy --workspace=@indigram/database",
    "db:studio": "npm run db:studio --workspace=@indigram/database",
    "db:seed": "npm run db:seed --workspace=@indigram/database",
    "test": "npm run test --workspace=@indigram/api",
    "worker:dev": "npm run dev --workspace=@indigram/worker",
    "worker:build": "npm run build --workspace=@indigram/worker"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
